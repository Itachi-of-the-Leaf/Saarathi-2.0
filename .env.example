# Saarathi Zero-Trust Auditor Configuration

# Database
SQLITE_DB_PATH=saarathi.db

# Switch Configuration
SWITCH_BASE_URL=https://api.switch.example.com
SWITCH_TOKEN=<set-switch-token>
SWITCH_ROOM_ID=room_switch_demo
AGENT_ID=saarathi-auditor

# Slack delivery (optional; required for Slack demo replies)
SLACK_API_BASE=https://slack.com/api
SLACK_BOT_TOKEN=<set-slack-bot-token>
SLACK_DEFAULT_CHANNEL_ID=C0123456789

# GitHub Configuration (Read-only access)
GITHUB_API_BASE=https://api.github.com
GITHUB_TOKEN=<set-github-read-token>
GITHUB_REPO=switch-org/switch-core

# Coordinator & Audit Settings
TICKER_INTERVAL_SECONDS=60
DEFAULT_POLICY_ID=default_policy

